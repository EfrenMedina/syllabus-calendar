# URL of the FastAPI extraction service (Render URL in production)
EXTRACT_SERVICE_URL=http://127.0.0.1:8000
# Shared secret sent to FastAPI on every /extract call. Must match the API's value.
# Generate one with: openssl rand -hex 32
EXTRACT_SERVICE_TOKEN=
# Upstash Redis for per-IP rate limiting across serverless instances (production).
# Vercel's Storage integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; either works.
# Without these, rate limiting falls back to per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
